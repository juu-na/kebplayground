# Copy this file to .env and put your own key in.
# .env is gitignored, so the key never leaves your machine.

GEMINI_API_KEY=your_actual_api_key_here

# The admin pages take this token as ?token=...
ADMIN_TOKEN=pick_something_long

# Signing in with Google. The client comes from the OAuth credentials page,
# with http://localhost:8123/auth/callback listed as a redirect URI.
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret

# Signs the session cookie. Any long random string, openssl rand -hex 32.
SESSION_SECRET=pick_something_long

# Who may sign in. Left out, only aucklanduni.ac.nz accounts can.
# ALLOWED_EMAIL_DOMAIN=aucklanduni.ac.nz
